# pixi environments
.pixi/*
!.pixi/config.toml

# Node
node_modules/

# Hugo build output & caches
/public/
/resources/_gen/
.hugo_build.lock
hugo_stats.json


# Hudson conditions, generated at build time by `pixi run conditions`.
# Deliberately not committed: the plots would add hundreds of KB to git
# history every day, and the deploy regenerates them anyway.
/data/conditions.json
/static/img/conditions/

# Upcoming Meetup sessions, generated at build time by `pixi run events`.
# Not committed for the same reason: the deploy regenerates it every time.
/data/events.json

# OS files
.DS_Store

# Original WordPress archive — reference only, not part of the site
/wayback-archive-2026-04-10/
